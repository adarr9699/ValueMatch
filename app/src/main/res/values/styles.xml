<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavText">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">999dp</item>
    </style>

    <style name="Widget.ValueMatch.ValueChip"
        parent="Widget.MaterialComponents.Chip.Choice">

        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@android:color/white</item>
        <item name="chipStrokeWidth">1dp</item>

        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>

        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">32dp</item>

        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>

    </style>

</resources>