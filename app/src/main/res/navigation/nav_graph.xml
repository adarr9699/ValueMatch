<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.valuematch.ui.fragments.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.valuematch.ui.fragments.SignupFragment"
        android:label="Signup">

        <action
            android:id="@+id/action_signupFragment_to_valuesFragment"
            app:destination="@id/valuesFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.valuematch.ui.fragments.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_swipeFragment"
            app:destination="@id/swipeFragment" />

        <action
            android:id="@+id/action_homeFragment_to_matchesFragment"
            app:destination="@id/matchesFragment" />

        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_homeFragment_to_valuesFragment"
            app:destination="@id/valuesFragment" />

        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />

        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.valuematch.ui.fragments.ProfileFragment"
        android:label="Profile">

        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <action
            android:id="@+id/action_profileFragment_to_valuesFragment"
            app:destination="@id/valuesFragment" />

        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/valuesFragment"
        android:name="com.example.valuematch.ui.fragments.ValuesFragment"
        android:label="Values">

        <action
            android:id="@+id/action_valuesFragment_to_swipeFragment"
            app:destination="@id/swipeFragment" />
    </fragment>

    <fragment
        android:id="@+id/swipeFragment"
        android:name="com.example.valuematch.ui.fragments.SwipeFragment"
        android:label="Swipe">

        <action
            android:id="@+id/action_swipeFragment_to_valuesFragment"
            app:destination="@id/valuesFragment" />

        <action
            android:id="@+id/action_swipeFragment_to_matchesFragment"
            app:destination="@id/matchesFragment" />

        <action
            android:id="@+id/action_swipeFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/matchesFragment"
        android:name="com.example.valuematch.ui.fragments.MatchesFragment"
        android:label="Matches">

        <action
            android:id="@+id/action_matchesFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.valuematch.ui.fragments.ChatFragment"
        android:label="Chat">

        <argument
            android:name="otherUserId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.valuematch.ui.fragments.SettingsFragment"
        android:label="Settings">

        <action
            android:id="@+id/action_settingsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_valuesFragment"
            app:destination="@id/valuesFragment" />

        <action
            android:id="@+id/action_settingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>

