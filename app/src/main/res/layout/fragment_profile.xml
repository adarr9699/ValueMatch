<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0F"
    android:padding="18dp">

    <ImageView
        android:id="@+id/profilePhoto"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_profile"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/profileNameAge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="User, 21"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="28sp"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@id/profilePhoto"
        app:layout_constraintTop_toTopOf="@id/profilePhoto"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/profileValuesGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/profileNameAge"
        app:layout_constraintTop_toBottomOf="@id/profileNameAge"
        app:layout_constraintEnd_toEndOf="parent"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"/>

    <Button
        android:id="@+id/btnEditProfile"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Edit Profile"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#E91E63"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/profilePhoto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>