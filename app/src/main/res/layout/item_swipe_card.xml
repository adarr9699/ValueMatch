<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Profile Image -->
            <ImageView
                android:id="@+id/cardPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />

            <!-- Bottom Gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_black_fade_bottom" />

            <!-- LIKE Stamp -->
            <TextView
                android:id="@+id/stampLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="18dp"
                android:background="@drawable/bg_stamp_border_green"
                android:padding="10dp"
                android:rotation="-12"
                android:text="LIKE"
                android:textColor="#00E676"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- NOPE Stamp -->
            <TextView
                android:id="@+id/stampNope"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="18dp"
                android:background="@drawable/bg_stamp_border_red"
                android:padding="10dp"
                android:rotation="12"
                android:text="NOPE"
                android:textColor="#FF1744"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Name + Age -->
            <TextView
                android:id="@+id/cardNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="124dp"
                android:text="Name 22"
                android:textColor="@android:color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Values Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/valueChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="84dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Value 1"
                    android:textColor="#EC407A"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Value 2"
                    android:textColor="#EC407A"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Value 3"
                    android:textColor="#EC407A"
                    android:visibility="gone" />

            </com.google.android.material.chip.ChipGroup>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>