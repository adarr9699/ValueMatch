<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ValueMatch Home"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/goToProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Profile" />

    <Button
        android:id="@+id/goToSwipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start Swiping" />

    <Button
        android:id="@+id/goToMatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="My Matches" />

    <Button
        android:id="@+id/goToMessagesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Messages" />

    <Button
        android:id="@+id/goToValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Values"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/goToSettingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="12dp"/>


</LinearLayout>
